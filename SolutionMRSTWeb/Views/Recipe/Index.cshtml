@model IEnumerable<SolutionMRSTWeb.Models.Recipe>

@{
    ViewBag.Title = "Recipes";
}

<div class="container">
    <h2>Recipes</h2>

    <p>
        @Html.ActionLink("Create New Recipe", "Create", null, new { @class = "btn btn-primary" })
    </p>

    <div class="row mb-4">
        <div class="col-md-12">
            @using (Html.BeginForm("Index", "Recipe", FormMethod.Get))
            {
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.TextBox("searchString", null, new { @class = "form-control", placeholder = "Search recipes..." })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.DropDownList("difficulty", new SelectList(ViewBag.Difficulties), "Select Difficulty", new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.TextBox("cookingTime", null, new { @class = "form-control", placeholder = "Max cooking time (min)" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.DropDownList("category", new SelectList(ViewBag.Categories, "Name", "Name"), "Select Category", new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary">Filter</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text">@item.Description</p>
                        <p class="card-text">
                            <small class="text-muted">
                                Cooking Time: @item.CookingTime minutes | Difficulty: @item.Difficulty
                            </small>
                        </p>
                        <div class="btn-group">
                            @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info" })
                            @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning" })
                            @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger" })
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div> 